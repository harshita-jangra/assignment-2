<%- include('../partials/head') %>

<div class="app-container">
  <%- include('../partials/sidebar') %>

  <div class="main-wrapper">
    <%- include('../partials/header', { 
      pageHeadline: 'Executive Administration',
      pageSubheadline: 'Comprehensive asset governance, inventory auditing, and lifecycle monitoring.'
    }) %>
    <%- include('../partials/toasts') %>

    <main class="content-body">
      <!-- Executive Statistics Grid -->
      <div class="stats-grid">
        <div class="stat-card">
          <div class="stat-header">
            <span class="stat-label">Total Assets</span>
            <div class="stat-icon">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <path d="M21 16V8a2 2 0 0 0-1-1.73l-7-4a2 2 0 0 0-2 0l-7 4A2 2 0 0 0 3 8v8a2 2 0 0 0 1 1.73l7 4a2 2 0 0 0 2 0l7-4A2 2 0 0 0 21 16z"></path>
              </svg>
            </div>
          </div>
          <div class="stat-value"><%= stats.totalAssets %></div>
          <div class="stat-subtext"><%= stats.totalUnits %> Total Physical Units</div>
        </div>

        <div class="stat-card">
          <div class="stat-header">
            <span class="stat-label">Available In Stock</span>
            <div class="stat-icon" style="background: rgba(20, 90, 45, 0.4);">
              <svg viewBox="0 0 24 24" fill="none" stroke="#10B981" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"></path>
                <polyline points="22 4 12 14.01 9 11.01"></polyline>
              </svg>
            </div>
          </div>
          <div class="stat-value" style="color: #A3E635;"><%= stats.availableUnits %></div>
          <div class="stat-subtext">Ready for immediate issue</div>
        </div>

        <div class="stat-card">
          <div class="stat-header">
            <span class="stat-label">Currently Issued</span>
            <div class="stat-icon" style="background: rgba(74, 14, 28, 0.6);">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <rect x="2" y="7" width="20" height="14" rx="2" ry="2"></rect>
                <path d="M16 21V5a2 2 0 0 0-2-2h-4a2 2 0 0 0-2 2v16"></path>
              </svg>
            </div>
          </div>
          <div class="stat-value" style="color: var(--champagne);"><%= stats.issuedUnits %></div>
          <div class="stat-subtext">In student/staff possession</div>
        </div>

        <div class="stat-card" style="<%= stats.overdueCount > 0 ? 'border-color: #EF4444;' : '' %>">
          <div class="stat-header">
            <span class="stat-label" style="<%= stats.overdueCount > 0 ? 'color: #EF4444;' : '' %>">Overdue Returns</span>
            <div class="stat-icon" style="background: rgba(180, 20, 30, 0.3);">
              <svg viewBox="0 0 24 24" fill="none" stroke="<%= stats.overdueCount > 0 ? '#EF4444' : 'currentColor' %>" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <circle cx="12" cy="12" r="10"></circle>
                <line x1="12" y1="8" x2="12" y2="12"></line>
                <line x1="12" y1="16" x2="12.01" y2="16"></line>
              </svg>
            </div>
          </div>
          <div class="stat-value" style="<%= stats.overdueCount > 0 ? 'color: #EF4444;' : '' %>"><%= stats.overdueCount %></div>
          <div class="stat-subtext">Requires immediate recovery</div>
        </div>

        <div class="stat-card">
          <div class="stat-header">
            <span class="stat-label">Pending Approval</span>
            <div class="stat-icon" style="background: rgba(100, 21, 42, 0.4);">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <circle cx="12" cy="12" r="10"></circle>
                <polyline points="12 6 12 12 16 14"></polyline>
              </svg>
            </div>
          </div>
          <div class="stat-value"><%= stats.pendingCount %></div>
          <div class="stat-subtext"><%= stats.approvedCount %> Approved awaiting handover</div>
        </div>

        <div class="stat-card">
          <div class="stat-header">
            <span class="stat-label">Damaged / In Service</span>
            <div class="stat-icon" style="background: rgba(190, 120, 20, 0.25);">
              <svg viewBox="0 0 24 24" fill="none" stroke="#F3C472" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <path d="M14.7 6.3a1 1 0 0 0 0 1.4l1.6 1.6a1 1 0 0 0 1.4 0l3.77-3.77a6 6 0 0 1-7.94 7.94l-6.91 6.91a2.12 2.12 0 0 1-3-3l6.91-6.91a6 6 0 0 1 7.94-7.94l-3.76 3.76z"></path>
              </svg>
            </div>
          </div>
          <div class="stat-value" style="color: #F3C472;"><%= stats.damagedUnits %></div>
          <div class="stat-subtext"><%= stats.lostUnits %> Units Logged Lost</div>
        </div>
      </div>

      <!-- Quick Action Toolbar -->
      <div style="display: flex; gap: 1rem; margin-bottom: 2rem; flex-wrap: wrap;">
        <a href="/admin/assets/add" class="btn btn-primary">
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <circle cx="12" cy="12" r="10"></circle>
            <line x1="12" y1="8" x2="12" y2="16"></line>
            <line x1="8" y1="12" x2="16" y2="12"></line>
          </svg>
          Register New Asset
        </a>
        <a href="/admin/assets" class="btn btn-secondary">Manage Inventory</a>
        <a href="/admin/requests" class="btn btn-secondary">Audit All Requests</a>
        <a href="/admin/maintenance" class="btn btn-secondary">Maintenance Records</a>
        <a href="/admin/users" class="btn btn-secondary">Users Directory (<%= stats.totalUsers %>)</a>
      </div>

      <!-- Overdue Alerts Section -->
      <% if (overdueRequests && overdueRequests.length > 0) { %>
        <div class="glass-panel" style="border-color: rgba(239, 68, 68, 0.5);">
          <div class="panel-header" style="background: rgba(42, 7, 16, 0.9);">
            <div class="panel-title" style="color: #FCA5A5;">
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="#EF4444" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <circle cx="12" cy="12" r="10"></circle>
                <line x1="12" y1="8" x2="12" y2="12"></line>
                <line x1="12" y1="16" x2="12.01" y2="16"></line>
              </svg>
              Overdue Equipment Alert
            </div>
            <a href="/admin/requests?status=Issued" class="btn btn-danger btn-sm">Audit Active Loans</a>
          </div>

          <div class="table-responsive">
            <table class="custom-table">
              <thead>
                <tr>
                  <th>Requester</th>
                  <th>Equipment / Asset Tag</th>
                  <th>Quantity</th>
                  <th>Expected Return</th>
                  <th>Status</th>
                </tr>
              </thead>
              <tbody>
                <% overdueRequests.forEach(reqItem => { %>
                  <tr>
                    <td>
                      <strong><%= reqItem.requester ? reqItem.requester.name : 'Unknown' %></strong>
                      <div style="font-size: 0.75rem; color: var(--muted-text);"><%= reqItem.requester ? reqItem.requester.email : '' %></div>
                    </td>
                    <td>
                      <strong><%= reqItem.asset ? reqItem.asset.name : 'N/A' %></strong>
                      <div class="asset-tag"><%= reqItem.asset ? reqItem.asset.assetTag : '' %></div>
                    </td>
                    <td><span class="badge badge-category"><%= reqItem.quantity %> Units</span></td>
                    <td style="color: #F87171; font-weight: 600;"><%= new Date(reqItem.expectedReturnDate).toLocaleDateString() %></td>
                    <td><span class="badge badge-overdue">OVERDUE</span></td>
                  </tr>
                <% }) %>
              </tbody>
            </table>
          </div>
        </div>
      <% } %>

      <!-- Recent Requisitions & Activity Grid -->
      <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(360px, 1fr)); gap: 1.5rem;">
        <!-- Recent Requests -->
        <div class="glass-panel">
          <div class="panel-header">
            <div class="panel-title">Recent Requisitions</div>
            <a href="/admin/requests" class="btn btn-secondary btn-sm">View All</a>
          </div>
          <div class="table-responsive">
            <% if (recentRequests && recentRequests.length > 0) { %>
              <table class="custom-table">
                <thead>
                  <tr>
                    <th>Requester</th>
                    <th>Equipment</th>
                    <th>Qty</th>
                    <th>Status</th>
                  </tr>
                </thead>
                <tbody>
                  <% recentRequests.forEach(r => { %>
                    <tr>
                      <td><%= r.requester ? r.requester.name : 'Unknown' %></td>
                      <td><%= r.asset ? r.asset.name : 'N/A' %></td>
                      <td><%= r.quantity %></td>
                      <td>
                        <% if (r.status === 'Pending') { %>
                          <span class="badge badge-pending">Pending</span>
                        <% } else if (r.status === 'Approved') { %>
                          <span class="badge badge-approved">Approved</span>
                        <% } else if (r.status === 'Issued') { %>
                          <span class="badge badge-issued">Issued</span>
                        <% } else if (r.status === 'Returned') { %>
                          <span class="badge badge-returned">Returned</span>
                        <% } else { %>
                          <span class="badge badge-lost"><%= r.status %></span>
                        <% } %>
                      </td>
                    </tr>
                  <% }) %>
                </tbody>
              </table>
            <% } else { %>
              <div class="empty-state" style="padding: 2rem;">No requisitions yet.</div>
            <% } %>
          </div>
        </div>

        <!-- Upcoming Maintenance -->
        <div class="glass-panel">
          <div class="panel-header">
            <div class="panel-title">Equipment In Servicing / Maintenance</div>
            <a href="/admin/maintenance" class="btn btn-secondary btn-sm">View Logs</a>
          </div>
          <div class="table-responsive">
            <% if (upcomingMaintenance && upcomingMaintenance.length > 0) { %>
              <table class="custom-table">
                <thead>
                  <tr>
                    <th>Equipment</th>
                    <th>Description</th>
                    <th>Status</th>
                  </tr>
                </thead>
                <tbody>
                  <% upcomingMaintenance.forEach(m => { %>
                    <tr>
                      <td>
                        <strong><%= m.asset ? m.asset.name : 'N/A' %></strong>
                        <div class="asset-tag"><%= m.asset ? m.asset.assetTag : '' %></div>
                      </td>
                      <td style="color: var(--muted-text); font-size: 0.8rem;"><%= m.description %></td>
                      <td><span class="badge badge-damaged"><%= m.status %></span></td>
                    </tr>
                  <% }) %>
                </tbody>
              </table>
            <% } else { %>
              <div class="empty-state" style="padding: 2rem;">
                <p>All institutional equipment in active stock is operational.</p>
              </div>
            <% } %>
          </div>
        </div>
      </div>
    </main>
  </div>
</div>

<%- include('../partials/footer') %>
