<%- include('../partials/head') %>

<div class="app-container">
  <%- include('../partials/sidebar') %>

  <div class="main-wrapper">
    <%- include('../partials/header', { 
      pageHeadline: 'Maintenance & Calibration Log',
      pageSubheadline: 'Service records, repair expenditures, and equipment health status.'
    }) %>
    <%- include('../partials/toasts') %>

    <main class="content-body">
      <!-- Maintenance Metrics -->
      <div class="stats-grid" style="grid-template-columns: repeat(auto-fit, minmax(240px, 1fr));">
        <div class="stat-card">
          <div class="stat-header">
            <span class="stat-label">Total Service Expenditure</span>
            <div class="stat-icon" style="background: rgba(200, 169, 107, 0.2);">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <line x1="12" y1="1" x2="12" y2="23"></line>
                <path d="M17 5H9.5a3.5 3.5 0 0 0 0 7h5a3.5 3.5 0 0 1 0 7H6"></path>
              </svg>
            </div>
          </div>
          <div class="stat-value" style="color: var(--champagne);">$<%= totalCost.toFixed(2) %></div>
          <div class="stat-subtext">Cumulative repair & calibration costs</div>
        </div>

        <div class="stat-card">
          <div class="stat-header">
            <span class="stat-label">Active / Scheduled Tickets</span>
            <div class="stat-icon" style="background: rgba(100, 21, 42, 0.4);">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <path d="M14.7 6.3a1 1 0 0 0 0 1.4l1.6 1.6a1 1 0 0 0 1.4 0l3.77-3.77a6 6 0 0 1-7.94 7.94l-6.91 6.91a2.12 2.12 0 0 1-3-3l6.91-6.91a6 6 0 0 1 7.94-7.94l-3.76 3.76z"></path>
              </svg>
            </div>
          </div>
          <div class="stat-value">
            <%= maintenanceLogs.filter(m => m.status !== 'Completed').length %>
          </div>
          <div class="stat-subtext">Equipment currently undergoing repair</div>
        </div>

        <div class="stat-card">
          <div class="stat-header">
            <span class="stat-label">Completed Services</span>
            <div class="stat-icon" style="background: rgba(20, 90, 45, 0.4);">
              <svg viewBox="0 0 24 24" fill="none" stroke="#10B981" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <polyline points="20 6 9 17 4 12"></polyline>
              </svg>
            </div>
          </div>
          <div class="stat-value" style="color: #A3E635;">
            <%= maintenanceLogs.filter(m => m.status === 'Completed').length %>
          </div>
          <div class="stat-subtext">Historical verified maintenance jobs</div>
        </div>
      </div>

      <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(360px, 1fr)); gap: 2rem;">
        <!-- Left: Service Log Form -->
        <div class="glass-panel">
          <div class="panel-header">
            <div class="panel-title">
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <circle cx="12" cy="12" r="10"></circle>
                <line x1="12" y1="8" x2="12" y2="16"></line>
                <line x1="8" y1="12" x2="16" y2="12"></line>
              </svg>
              Log New Service Record
            </div>
          </div>

          <div class="panel-body">
            <form action="/admin/maintenance/add" method="POST">
              <div class="form-group">
                <label class="form-label" for="assetId">Laboratory Asset *</label>
                <select id="assetId" name="assetId" class="form-control" required>
                  <option value="">-- Select Asset --</option>
                  <% assets.forEach(a => { %>
                    <option value="<%= a._id %>">
                      [<%= a.assetTag %>] <%= a.name %> (<%= a.condition %>)
                    </option>
                  <% }) %>
                </select>
              </div>

              <div class="form-row">
                <div class="form-group">
                  <label class="form-label" for="serviceDate">Service Date</label>
                  <input type="date" id="serviceDate" name="serviceDate" class="form-control">
                </div>

                <div class="form-group">
                  <label class="form-label" for="cost">Cost ($ / ₹)</label>
                  <input type="number" id="cost" name="cost" class="form-control" min="0" step="0.01" value="0" required>
                </div>
              </div>

              <div class="form-group">
                <label class="form-label" for="description">Service Description *</label>
                <textarea 
                  id="description" 
                  name="description" 
                  class="form-control" 
                  placeholder="e.g., Replaced blown input fuse, calibrated timebase, cleaned contacts..."
                  required
                ></textarea>
              </div>

              <div class="form-row">
                <div class="form-group">
                  <label class="form-label" for="status">Job Status</label>
                  <select id="status" name="status" class="form-control">
                    <option value="Completed">Completed</option>
                    <option value="In Progress">In Progress</option>
                    <option value="Scheduled">Scheduled</option>
                  </select>
                </div>

                <div class="form-group">
                  <label class="form-label" for="nextServiceDue">Next Due Date</label>
                  <input type="date" id="nextServiceDue" name="nextServiceDue" class="form-control">
                </div>
              </div>

              <div class="form-group" style="margin-top: 0.5rem;">
                <label style="display: flex; align-items: center; gap: 0.65rem; color: var(--cream); font-size: 0.88rem; cursor: pointer;">
                  <input type="checkbox" name="restoreToStock" value="yes" checked style="accent-color: var(--wine);">
                  <span>Restore 1 damaged unit back to available stock & set condition to 'Good' upon completion.</span>
                </label>
              </div>

              <button type="submit" class="btn btn-primary" style="width: 100%; margin-top: 0.5rem; padding: 0.85rem;">
                Save Service Record
              </button>
            </form>
          </div>
        </div>

        <!-- Right: Historical Logs Table -->
        <div class="glass-panel">
          <div class="panel-header">
            <div class="panel-title">
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"></path>
                <polyline points="14 2 14 8 20 8"></polyline>
              </svg>
              Maintenance History (<%= maintenanceLogs.length %>)
            </div>
          </div>

          <div class="table-responsive">
            <% if (maintenanceLogs && maintenanceLogs.length > 0) { %>
              <table class="custom-table">
                <thead>
                  <tr>
                    <th>Asset</th>
                    <th>Date</th>
                    <th>Description</th>
                    <th>Cost</th>
                    <th>Status</th>
                  </tr>
                </thead>
                <tbody>
                  <% maintenanceLogs.forEach(m => { %>
                    <tr>
                      <td>
                        <strong><%= m.asset ? m.asset.name : 'Archived' %></strong>
                        <div class="asset-tag"><%= m.asset ? m.asset.assetTag : '' %></div>
                      </td>
                      <td><%= new Date(m.serviceDate).toLocaleDateString() %></td>
                      <td style="color: var(--muted-text); font-size: 0.82rem; max-width: 180px;"><%= m.description %></td>
                      <td style="color: var(--champagne); font-weight: 600;">$<%= m.cost.toFixed(2) %></td>
                      <td>
                        <span class="badge <%= m.status === 'Completed' ? 'badge-approved' : 'badge-damaged' %>">
                          <%= m.status %>
                        </span>
                      </td>
                    </tr>
                  <% }) %>
                </tbody>
              </table>
            <% } else { %>
              <div class="empty-state">
                <p>No maintenance logs recorded yet.</p>
              </div>
            <% } %>
          </div>
        </div>
      </div>
    </main>
  </div>
</div>

<%- include('../partials/footer') %>
