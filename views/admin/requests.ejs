<%- include('../partials/head') %>

<div class="app-container">
  <%- include('../partials/sidebar') %>

  <div class="main-wrapper">
    <%- include('../partials/header', { 
      pageHeadline: 'System Audit Trail: Requests',
      pageSubheadline: 'Comprehensive ledger of all student and staff equipment transactions.'
    }) %>
    <%- include('../partials/toasts') %>

    <main class="content-body">
      <!-- Status Filters -->
      <div class="glass-panel" style="margin-bottom: 2rem;">
        <div class="panel-body" style="padding: 1rem 1.5rem; display: flex; gap: 0.5rem; flex-wrap: wrap; align-items: center;">
          <span style="font-size: 0.8rem; text-transform: uppercase; color: var(--champagne); font-weight: 700; margin-right: 0.5rem;">Filter by Status:</span>
          <% const statuses = ['All', 'Pending', 'Approved', 'Issued', 'Returned', 'Rejected']; %>
          <% statuses.forEach(st => { %>
            <a href="/admin/requests?status=<%= st %>" class="btn btn-sm <%= selectedStatus === st ? 'btn-primary' : 'btn-secondary' %>">
              <%= st %>
            </a>
          <% }) %>
        </div>
      </div>

      <!-- Master Ledger Table -->
      <div class="glass-panel">
        <div class="panel-header">
          <div class="panel-title">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <line x1="8" y1="6" x2="21" y2="6"></line>
              <line x1="8" y1="12" x2="21" y2="12"></line>
              <line x1="8" y1="18" x2="21" y2="18"></line>
              <line x1="3" y1="6" x2="3.01" y2="6"></line>
              <line x1="3" y1="12" x2="3.01" y2="12"></line>
              <line x1="3" y1="18" x2="3.01" y2="18"></line>
            </svg>
            Equipment Transaction Ledger (<%= requests.length %>)
          </div>
        </div>

        <div class="table-responsive">
          <% if (requests && requests.length > 0) { %>
            <table class="custom-table">
              <thead>
                <tr>
                  <th>Request ID</th>
                  <th>Requester</th>
                  <th>Asset / Tag</th>
                  <th>Qty</th>
                  <th>Purpose</th>
                  <th>Date</th>
                  <th>Due Date</th>
                  <th>Status</th>
                  <th>Audit Logs</th>
                </tr>
              </thead>
              <tbody>
                <% requests.forEach(r => { %>
                  <% const isOverdue = r.status === 'Issued' && new Date(r.expectedReturnDate) < now; %>
                  <tr>
                    <td>
                      <span style="font-family: monospace; font-size: 0.8rem; color: var(--champagne);">
                        #<%= r._id.toString().slice(-6).toUpperCase() %>
                      </span>
                    </td>
                    <td>
                      <strong><%= r.requester ? r.requester.name : 'Unknown' %></strong>
                      <div style="font-size: 0.72rem; color: var(--muted-text);"><%= r.requester ? r.requester.email : '' %></div>
                    </td>
                    <td>
                      <% if (r.asset) { %>
                        <strong><%= r.asset.name %></strong>
                        <div class="asset-tag"><%= r.asset.assetTag %></div>
                      <% } else { %>
                        <span>Archived Asset</span>
                      <% } %>
                    </td>
                    <td><span class="badge badge-category"><%= r.quantity %> Units</span></td>
                    <td style="color: var(--muted-text); max-width: 160px; font-size: 0.8rem;"><%= r.purpose %></td>
                    <td><%= new Date(r.requestDate).toLocaleDateString() %></td>
                    <td>
                      <span style="<%= isOverdue ? 'color: #EF4444; font-weight: 700;' : '' %>">
                        <%= new Date(r.expectedReturnDate).toLocaleDateString() %>
                      </span>
                    </td>
                    <td>
                      <% if (isOverdue) { %>
                        <span class="badge badge-overdue">⚠ OVERDUE</span>
                      <% } else if (r.status === 'Pending') { %>
                        <span class="badge badge-pending">Pending</span>
                      <% } else if (r.status === 'Approved') { %>
                        <span class="badge badge-approved">Approved</span>
                      <% } else if (r.status === 'Issued') { %>
                        <span class="badge badge-issued">Issued</span>
                      <% } else if (r.status === 'Returned') { %>
                        <span class="badge badge-returned">Returned</span>
                      <% } else { %>
                        <span class="badge badge-lost"><%= r.status %></span>
                      <% } %>
                    </td>
                    <td style="font-size: 0.78rem; color: var(--muted-text);">
                      <% if (r.approvedBy) { %>
                        <div>Approved by: <%= r.approvedBy.name %></div>
                      <% } %>
                      <% if (r.issuedBy) { %>
                        <div>Issued by: <%= r.issuedBy.name %></div>
                      <% } %>
                      <% if (r.returnedAt) { %>
                        <div style="color: var(--cream);">
                          Returned on: <%= new Date(r.returnedAt).toLocaleDateString() %> 
                          (<strong style="color: var(--champagne);"><%= r.returnCondition %></strong>)
                        </div>
                      <% } %>
                      <% if (r.rejectionReason) { %>
                        <div style="color: #F87171;">Reason: <%= r.rejectionReason %></div>
                      <% } %>
                    </td>
                  </tr>
                <% }) %>
              </tbody>
            </table>
          <% } else { %>
            <div class="empty-state">
              <h3>No Requisition Records</h3>
              <p>No transaction records found matching the selected status filter.</p>
            </div>
          <% } %>
        </div>
      </div>
    </main>
  </div>
</div>

<%- include('../partials/footer') %>
