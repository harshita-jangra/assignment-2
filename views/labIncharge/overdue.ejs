<%- include('../partials/head') %>

<div class="app-container">
  <%- include('../partials/sidebar') %>

  <div class="main-wrapper">
    <%- include('../partials/header', { 
      pageHeadline: 'Overdue Equipment Monitor',
      pageSubheadline: 'Automatic real-time detection of overdue institutional hardware.'
    }) %>
    <%- include('../partials/toasts') %>

    <main class="content-body">
      <div class="glass-panel" style="border-color: rgba(239, 68, 68, 0.45);">
        <div class="panel-header" style="background: rgba(42, 7, 16, 0.85);">
          <div class="panel-title" style="color: #FCA5A5;">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="#EF4444" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <circle cx="12" cy="12" r="10"></circle>
              <line x1="12" y1="8" x2="12" y2="12"></line>
              <line x1="12" y1="16" x2="12.01" y2="16"></line>
            </svg>
            Overdue Loans Requiring Retrieval (<%= overdueRequests.length %>)
          </div>
        </div>

        <div class="table-responsive">
          <% if (overdueRequests && overdueRequests.length > 0) { %>
            <table class="custom-table">
              <thead>
                <tr>
                  <th>Request ID</th>
                  <th>Requester Contact</th>
                  <th>Equipment / Asset Tag</th>
                  <th>Qty</th>
                  <th>Expected Return</th>
                  <th>Days Overdue</th>
                  <th>Action</th>
                </tr>
              </thead>
              <tbody>
                <% overdueRequests.forEach(reqItem => { %>
                  <% 
                    const diffTime = Math.abs(now - new Date(reqItem.expectedReturnDate));
                    const diffDays = Math.ceil(diffTime / (1000 * 60 * 60 * 24));
                  %>
                  <tr>
                    <td>
                      <span style="font-family: monospace; font-size: 0.8rem; color: var(--champagne);">
                        #<%= reqItem._id.toString().slice(-6).toUpperCase() %>
                      </span>
                    </td>
                    <td>
                      <strong><%= reqItem.requester ? reqItem.requester.name : 'Unknown' %></strong>
                      <div style="font-size: 0.75rem; color: var(--muted-text);">
                        <%= reqItem.requester ? reqItem.requester.email : '' %> · <%= reqItem.requester ? reqItem.requester.department : '' %>
                      </div>
                    </td>
                    <td>
                      <% if (reqItem.asset) { %>
                        <strong><%= reqItem.asset.name %></strong>
                        <div class="asset-tag"><%= reqItem.asset.assetTag %> · <%= reqItem.asset.location %></div>
                      <% } else { %>
                        <span>Archived Asset</span>
                      <% } %>
                    </td>
                    <td><span class="badge badge-category"><%= reqItem.quantity %> Units</span></td>
                    <td style="color: #F87171; font-weight: 600;">
                      <%= new Date(reqItem.expectedReturnDate).toLocaleDateString() %>
                    </td>
                    <td>
                      <span class="badge badge-overdue">
                        ⚠ <%= diffDays %> Day<%= diffDays > 1 ? 's' : '' %> Overdue
                      </span>
                    </td>
                    <td>
                      <button 
                        type="button" 
                        class="btn btn-primary btn-sm"
                        onclick="setupReturnModal('<%= reqItem._id %>', '<%= reqItem.asset ? reqItem.asset.name : 'Asset' %>', '<%= reqItem.requester ? reqItem.requester.name : 'Requester' %>', '<%= reqItem.quantity %>')"
                      >
                        Record Return
                      </button>
                    </td>
                  </tr>
                <% }) %>
              </tbody>
            </table>
          <% } else { %>
            <div class="empty-state">
              <svg class="empty-state-icon" style="color: #10B981;" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
                <path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"></path>
                <polyline points="22 4 12 14.01 9 11.01"></polyline>
              </svg>
              <h3 style="color: #10B981;">No Overdue Equipment</h3>
              <p>All laboratory hardware loans are currently on schedule within their expected loan durations.</p>
            </div>
          <% } %>
        </div>
      </div>
    </main>
  </div>
</div>

<!-- Modal: Record Return -->
<div class="modal-overlay" id="returnModal">
  <div class="modal-dialog">
    <div class="modal-header">
      <h3>Record Equipment Return</h3>
      <button type="button" class="modal-close-btn" onclick="closeModal('returnModal')">&times;</button>
    </div>
    <form action="/lab/return" method="POST">
      <div class="modal-body">
        <input type="hidden" id="returnRequestId" name="requestId" value="">

        <div style="background: rgba(74, 14, 28, 0.3); border: 1px solid var(--border-burgundy); border-radius: 8px; padding: 0.85rem; margin-bottom: 1.25rem;">
          <span style="font-size: 0.75rem; text-transform: uppercase; color: var(--champagne); display: block;">Item Returning</span>
          <div id="returnItemSummary" style="font-weight: 600; color: var(--cream); font-size: 0.95rem; margin-top: 0.2rem;"></div>
        </div>

        <div class="form-group">
          <label class="form-label" for="returnCondition">Inspected Condition</label>
          <select id="returnCondition" name="returnCondition" class="form-control" required>
            <option value="OK">OK — Restores units directly back to available stock</option>
            <option value="Damaged">Damaged — Isolates units and creates maintenance ticket</option>
            <option value="Lost">Lost — Deducts units from institutional inventory</option>
          </select>
        </div>

        <div class="form-group">
          <label class="form-label" for="returnRemarks">Inspection Remarks</label>
          <textarea 
            id="returnRemarks" 
            name="returnRemarks" 
            class="form-control" 
            placeholder="e.g., Returned after overdue notice, tested ok..."
          ></textarea>
        </div>
      </div>
      <div class="modal-footer">
        <button type="button" class="btn btn-secondary btn-sm" onclick="closeModal('returnModal')">Cancel</button>
        <button type="submit" class="btn btn-primary btn-sm">Complete Return</button>
      </div>
    </form>
  </div>
</div>

<%- include('../partials/footer') %>
