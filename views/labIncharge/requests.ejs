<%- include('../partials/head') %>

<div class="app-container">
  <%- include('../partials/sidebar') %>

  <div class="main-wrapper">
    <%- include('../partials/header', { 
      pageHeadline: 'Manage Equipment Requests',
      pageSubheadline: 'Review pending student applications and execute physical hardware issuance.'
    }) %>
    <%- include('../partials/toasts') %>

    <main class="content-body">
      <!-- Section 1: Pending Requests -->
      <div class="glass-panel">
        <div class="panel-header">
          <div class="panel-title">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <circle cx="12" cy="12" r="10"></circle>
              <polyline points="12 6 12 12 16 14"></polyline>
            </svg>
            Pending Requests (<%= pendingRequests.length %>)
          </div>
        </div>

        <div class="table-responsive">
          <% if (pendingRequests && pendingRequests.length > 0) { %>
            <table class="custom-table">
              <thead>
                <tr>
                  <th>Request ID</th>
                  <th>Requester</th>
                  <th>Equipment / Tag</th>
                  <th>Qty</th>
                  <th>Stock Check</th>
                  <th>Purpose</th>
                  <th>Due Date</th>
                  <th>Actions</th>
                </tr>
              </thead>
              <tbody>
                <% pendingRequests.forEach(reqItem => { %>
                  <tr>
                    <td>
                      <span style="font-family: monospace; font-size: 0.8rem; color: var(--champagne);">
                        #<%= reqItem._id.toString().slice(-6).toUpperCase() %>
                      </span>
                    </td>
                    <td>
                      <strong><%= reqItem.requester ? reqItem.requester.name : 'Unknown' %></strong>
                      <div style="font-size: 0.75rem; color: var(--muted-text);"><%= reqItem.requester ? reqItem.requester.email : '' %></div>
                    </td>
                    <td>
                      <% if (reqItem.asset) { %>
                        <strong><%= reqItem.asset.name %></strong>
                        <div class="asset-tag"><%= reqItem.asset.assetTag %> · <%= reqItem.asset.location %></div>
                      <% } else { %>
                        <span>Archived Asset</span>
                      <% } %>
                    </td>
                    <td><span class="badge badge-category"><%= reqItem.quantity %> Units</span></td>
                    <td>
                      <% if (reqItem.asset) { %>
                        <% if (reqItem.asset.availableQuantity >= reqItem.quantity) { %>
                          <span style="color: #A3E635; font-weight: 600;">✓ <%= reqItem.asset.availableQuantity %> Available</span>
                        <% } else { %>
                          <span style="color: #F87171; font-weight: 600;">✕ Only <%= reqItem.asset.availableQuantity %> Left</span>
                        <% } %>
                      <% } %>
                    </td>
                    <td style="color: var(--muted-text); max-width: 200px;"><%= reqItem.purpose %></td>
                    <td><%= new Date(reqItem.expectedReturnDate).toLocaleDateString() %></td>
                    <td>
                      <div style="display: flex; gap: 0.4rem;">
                        <form action="/lab/approve" method="POST" style="display: inline;">
                          <input type="hidden" name="requestId" value="<%= reqItem._id %>">
                          <button type="submit" class="btn btn-success btn-sm">Approve</button>
                        </form>
                        <button type="button" class="btn btn-danger btn-sm" onclick="setupRejectModal('<%= reqItem._id %>', '<%= reqItem.asset ? reqItem.asset.name : 'Asset' %>')">
                          Reject
                        </button>
                      </div>
                    </td>
                  </tr>
                <% }) %>
              </tbody>
            </table>
          <% } else { %>
            <div class="empty-state">
              <svg class="empty-state-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
                <circle cx="12" cy="12" r="10"></circle>
                <polyline points="12 6 12 12 16 14"></polyline>
              </svg>
              <h3>No Pending Requests</h3>
              <p>There are currently no requisitions waiting for approval.</p>
            </div>
          <% } %>
        </div>
      </div>

      <!-- Section 2: Approved Requests (Ready to Issue) -->
      <div class="glass-panel">
        <div class="panel-header" style="background: rgba(74, 14, 28, 0.4);">
          <div class="panel-title">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <polyline points="20 6 9 17 4 12"></polyline>
            </svg>
            Approved Requisitions Ready for Physical Issuance (<%= approvedRequests.length %>)
          </div>
        </div>

        <div class="table-responsive">
          <% if (approvedRequests && approvedRequests.length > 0) { %>
            <table class="custom-table">
              <thead>
                <tr>
                  <th>Request ID</th>
                  <th>Requester</th>
                  <th>Equipment / Tag</th>
                  <th>Quantity</th>
                  <th>Approved Date</th>
                  <th>Expected Return</th>
                  <th>Action</th>
                </tr>
              </thead>
              <tbody>
                <% approvedRequests.forEach(reqItem => { %>
                  <tr>
                    <td>
                      <span style="font-family: monospace; font-size: 0.8rem; color: var(--champagne);">
                        #<%= reqItem._id.toString().slice(-6).toUpperCase() %>
                      </span>
                    </td>
                    <td>
                      <strong><%= reqItem.requester ? reqItem.requester.name : 'Unknown' %></strong>
                      <div style="font-size: 0.75rem; color: var(--muted-text);"><%= reqItem.requester ? reqItem.requester.email : '' %></div>
                    </td>
                    <td>
                      <% if (reqItem.asset) { %>
                        <strong><%= reqItem.asset.name %></strong>
                        <div class="asset-tag"><%= reqItem.asset.assetTag %> · <%= reqItem.asset.location %></div>
                      <% } else { %>
                        <span>Archived Asset</span>
                      <% } %>
                    </td>
                    <td><span class="badge badge-category"><%= reqItem.quantity %> Units</span></td>
                    <td><%= reqItem.approvedAt ? new Date(reqItem.approvedAt).toLocaleDateString() : 'N/A' %></td>
                    <td><%= new Date(reqItem.expectedReturnDate).toLocaleDateString() %></td>
                    <td>
                      <form action="/lab/issue" method="POST">
                        <input type="hidden" name="requestId" value="<%= reqItem._id %>">
                        <button type="submit" class="btn btn-primary btn-sm">
                          <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                            <rect x="2" y="7" width="20" height="14" rx="2" ry="2"></rect>
                            <path d="M16 21V5a2 2 0 0 0-2-2h-4a2 2 0 0 0-2 2v16"></path>
                          </svg>
                          Record Issue (Handover)
                        </button>
                      </form>
                    </td>
                  </tr>
                <% }) %>
              </tbody>
            </table>
          <% } else { %>
            <div class="empty-state">
              <h3>No Approved Requests Awaiting Handover</h3>
              <p>Approve pending requisitions above to make them ready for physical issuance.</p>
            </div>
          <% } %>
        </div>
      </div>
    </main>
  </div>
</div>

<!-- Modal: Reject Request Reason -->
<div class="modal-overlay" id="rejectModal">
  <div class="modal-dialog">
    <div class="modal-header">
      <h3>Reject Requisition Request</h3>
      <button type="button" class="modal-close-btn" onclick="closeModal('rejectModal')">&times;</button>
    </div>
    <form action="/lab/reject" method="POST">
      <div class="modal-body">
        <input type="hidden" id="rejectRequestId" name="requestId" value="">
        <p id="rejectItemSummary" style="color: var(--cream); margin-bottom: 1rem; font-size: 0.9rem;"></p>

        <div class="form-group">
          <label class="form-label" for="rejectionReason">Reason for Rejection</label>
          <textarea 
            id="rejectionReason" 
            name="rejectionReason" 
            class="form-control" 
            placeholder="e.g., Equipment scheduled for calibration, insufficient stock..."
            required
          ></textarea>
        </div>
      </div>
      <div class="modal-footer">
        <button type="button" class="btn btn-secondary btn-sm" onclick="closeModal('rejectModal')">Cancel</button>
        <button type="submit" class="btn btn-danger btn-sm">Confirm Rejection</button>
      </div>
    </form>
  </div>
</div>

<%- include('../partials/footer') %>
