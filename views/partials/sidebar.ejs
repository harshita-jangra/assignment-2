<aside class="sidebar">
  <div class="sidebar-header">
    <div class="sidebar-logo">
      <div class="logo-shield">LV</div>
      <div class="logo-text">
        <h2>LABVAULT</h2>
        <p>Asset Management</p>
      </div>
    </div>
    <% if (typeof user !== 'undefined' && user) { %>
      <div class="sidebar-role-badge">
        <% if (user.role === 'admin') { %>
          ✦ Administrator
        <% } else if (user.role === 'labIncharge') { %>
          ⚗ Lab In-charge
        <% } else { %>
          ◈ Student / Staff
        <% } %>
      </div>
    <% } %>
  </div>

  <nav class="sidebar-nav">
    <div class="nav-section-title">Navigation</div>

    <% if (typeof user !== 'undefined' && user) { %>
      <%# Requester Navigation %>
      <% if (user.role === 'requester') { %>
        <a href="/requester/dashboard" class="nav-item <%= typeof pageTitle !== 'undefined' && pageTitle.includes('Dashboard') ? 'active' : '' %>">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round">
            <rect x="3" y="3" width="7" height="7"></rect>
            <rect x="14" y="3" width="7" height="7"></rect>
            <rect x="14" y="14" width="7" height="7"></rect>
            <rect x="3" y="14" width="7" height="7"></rect>
          </svg>
          Dashboard
        </a>
        <a href="/requester/browse" class="nav-item <%= typeof pageTitle !== 'undefined' && pageTitle.includes('Browse') ? 'active' : '' %>">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round">
            <circle cx="11" cy="11" r="8"></circle>
            <line x1="21" y1="21" x2="16.65" y2="16.65"></line>
          </svg>
          Browse Equipment
        </a>
        <a href="/requester/my-requests" class="nav-item <%= typeof pageTitle !== 'undefined' && pageTitle.includes('My Equipment Requests') ? 'active' : '' %>">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round">
            <path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"></path>
            <polyline points="14 2 14 8 20 8"></polyline>
            <line x1="16" y1="13" x2="8" y2="13"></line>
            <line x1="16" y1="17" x2="8" y2="17"></line>
          </svg>
          My Requests
        </a>
      <% } %>

      <%# Lab In-charge Navigation %>
      <% if (user.role === 'labIncharge') { %>
        <a href="/lab/dashboard" class="nav-item <%= typeof pageTitle !== 'undefined' && pageTitle.includes('Dashboard') ? 'active' : '' %>">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round">
            <rect x="3" y="3" width="7" height="7"></rect>
            <rect x="14" y="3" width="7" height="7"></rect>
            <rect x="14" y="14" width="7" height="7"></rect>
            <rect x="3" y="14" width="7" height="7"></rect>
          </svg>
          Dashboard
        </a>
        <a href="/lab/requests" class="nav-item <%= typeof pageTitle !== 'undefined' && pageTitle.includes('Manage Requests') ? 'active' : '' %>">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round">
            <path d="M9 11l3 3L22 4"></path>
            <path d="M21 12v7a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h11"></path>
          </svg>
          Manage Requests
        </a>
        <a href="/lab/issued" class="nav-item <%= typeof pageTitle !== 'undefined' && pageTitle.includes('Currently Issued') ? 'active' : '' %>">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round">
            <rect x="2" y="7" width="20" height="14" rx="2" ry="2"></rect>
            <path d="M16 21V5a2 2 0 0 0-2-2h-4a2 2 0 0 0-2 2v16"></path>
          </svg>
          Issued Equipment
        </a>
        <a href="/lab/overdue" class="nav-item <%= typeof pageTitle !== 'undefined' && pageTitle.includes('Overdue') ? 'active' : '' %>">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round">
            <circle cx="12" cy="12" r="10"></circle>
            <polyline points="12 6 12 12 16 14"></polyline>
          </svg>
          Overdue Monitor
        </a>
      <% } %>

      <%# Admin Navigation %>
      <% if (user.role === 'admin') { %>
        <a href="/admin/dashboard" class="nav-item <%= typeof pageTitle !== 'undefined' && pageTitle.includes('Dashboard') ? 'active' : '' %>">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round">
            <rect x="3" y="3" width="7" height="7"></rect>
            <rect x="14" y="3" width="7" height="7"></rect>
            <rect x="14" y="14" width="7" height="7"></rect>
            <rect x="3" y="14" width="7" height="7"></rect>
          </svg>
          Dashboard
        </a>
        <a href="/admin/assets" class="nav-item <%= typeof pageTitle !== 'undefined' && pageTitle.includes('Asset Inventory') ? 'active' : '' %>">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round">
            <path d="M21 16V8a2 2 0 0 0-1-1.73l-7-4a2 2 0 0 0-2 0l-7 4A2 2 0 0 0 3 8v8a2 2 0 0 0 1 1.73l7 4a2 2 0 0 0 2 0l7-4A2 2 0 0 0 21 16z"></path>
          </svg>
          Asset Inventory
        </a>
        <a href="/admin/assets/add" class="nav-item <%= typeof pageTitle !== 'undefined' && pageTitle.includes('Add New Asset') ? 'active' : '' %>">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round">
            <circle cx="12" cy="12" r="10"></circle>
            <line x1="12" y1="8" x2="12" y2="16"></line>
            <line x1="8" y1="12" x2="16" y2="12"></line>
          </svg>
          Add New Asset
        </a>
        <a href="/admin/requests" class="nav-item <%= typeof pageTitle !== 'undefined' && pageTitle.includes('All System Requests') ? 'active' : '' %>">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round">
            <line x1="8" y1="6" x2="21" y2="6"></line>
            <line x1="8" y1="12" x2="21" y2="12"></line>
            <line x1="8" y1="18" x2="21" y2="18"></line>
            <line x1="3" y1="6" x2="3.01" y2="6"></line>
            <line x1="3" y1="12" x2="3.01" y2="12"></line>
            <line x1="3" y1="18" x2="3.01" y2="18"></line>
          </svg>
          Audit Requests
        </a>
        <a href="/admin/maintenance" class="nav-item <%= typeof pageTitle !== 'undefined' && pageTitle.includes('Maintenance') ? 'active' : '' %>">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round">
            <path d="M14.7 6.3a1 1 0 0 0 0 1.4l1.6 1.6a1 1 0 0 0 1.4 0l3.77-3.77a6 6 0 0 1-7.94 7.94l-6.91 6.91a2.12 2.12 0 0 1-3-3l6.91-6.91a6 6 0 0 1 7.94-7.94l-3.76 3.76z"></path>
          </svg>
          Maintenance
        </a>
        <a href="/admin/users" class="nav-item <%= typeof pageTitle !== 'undefined' && pageTitle.includes('User Directory') ? 'active' : '' %>">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round">
            <path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"></path>
            <circle cx="9" cy="7" r="4"></circle>
            <path d="M23 21v-2a4 4 0 0 0-3-3.87"></path>
            <path d="M16 3.13a4 4 0 0 1 0 7.75"></path>
          </svg>
          User Directory
        </a>
      <% } %>
    <% } %>
  </nav>

  <div class="sidebar-footer">
    <% if (typeof user !== 'undefined' && user) { %>
      <div class="user-snippet">
        <div class="user-avatar"><%= user.name ? user.name.charAt(0).toUpperCase() : 'U' %></div>
        <div class="user-info">
          <div class="user-name"><%= user.name %></div>
          <div class="user-email"><%= user.email %></div>
        </div>
        <a href="/auth/logout" title="Sign Out" style="color: var(--muted-text); display: flex; padding: 4px;">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <path d="M9 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h4"></path>
            <polyline points="16 17 21 12 16 7"></polyline>
            <line x1="21" y1="12" x2="9" y2="12"></line>
          </svg>
        </a>
      </div>
    <% } %>
  </div>
</aside>
