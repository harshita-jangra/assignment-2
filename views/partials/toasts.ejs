<%# Flash Toasts Partial %>
<% if ((typeof success_msg !== 'undefined' && success_msg && success_msg.length > 0) || 
       (typeof error_msg !== 'undefined' && error_msg && error_msg.length > 0) || 
       (typeof warning_msg !== 'undefined' && warning_msg && warning_msg.length > 0)) { %>
  <div class="toast-container" id="toastContainer">
    <% if (typeof success_msg !== 'undefined' && success_msg) { %>
      <% success_msg.forEach(msg => { %>
        <div class="toast toast-success" role="alert">
          <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="#10B981" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <polyline points="20 6 9 17 4 12"></polyline>
          </svg>
          <div><%= msg %></div>
          <button type="button" class="toast-close" aria-label="Close">&times;</button>
        </div>
      <% }) %>
    <% } %>

    <% if (typeof error_msg !== 'undefined' && error_msg) { %>
      <% error_msg.forEach(msg => { %>
        <div class="toast toast-error" role="alert">
          <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="#EF4444" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <circle cx="12" cy="12" r="10"></circle>
            <line x1="15" y1="9" x2="9" y2="15"></line>
            <line x1="9" y1="9" x2="15" y2="15"></line>
          </svg>
          <div><%= msg %></div>
          <button type="button" class="toast-close" aria-label="Close">&times;</button>
        </div>
      <% }) %>
    <% } %>

    <% if (typeof warning_msg !== 'undefined' && warning_msg) { %>
      <% warning_msg.forEach(msg => { %>
        <div class="toast toast-warning" role="alert">
          <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="#F59E0B" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <path d="M10.29 3.86L1.82 18a2 2 0 0 0 1.71 3h16.94a2 2 0 0 0 1.71-3L13.71 3.86a2 2 0 0 0-3.42 0z"></path>
            <line x1="12" y1="9" x2="12" y2="13"></line>
            <line x1="12" y1="17" x2="12.01" y2="17"></line>
          </svg>
          <div><%= msg %></div>
          <button type="button" class="toast-close" aria-label="Close">&times;</button>
        </div>
      <% }) %>
    <% } %>
  </div>
<% } %>
