<%- include('../partials/head') %>

<div class="app-container">
  <%- include('../partials/sidebar') %>

  <div class="main-wrapper">
    <%- include('../partials/header', { 
      pageHeadline: asset.name,
      pageSubheadline: `Asset Tag: ${asset.assetTag} · Laboratory Location: ${asset.location}`
    }) %>
    <%- include('../partials/toasts') %>

    <main class="content-body">
      <div style="margin-bottom: 1.5rem;">
        <a href="/requester/browse" class="btn btn-secondary btn-sm">
          &larr; Back to Catalog
        </a>
      </div>

      <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(320px, 1fr)); gap: 2rem;">
        <!-- Left: Equipment Specifications Card -->
        <div class="glass-panel">
          <div class="panel-header">
            <div class="panel-title">
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <path d="M21 16V8a2 2 0 0 0-1-1.73l-7-4a2 2 0 0 0-2 0l-7 4A2 2 0 0 0 3 8v8a2 2 0 0 0 1 1.73l7 4a2 2 0 0 0 2 0l7-4A2 2 0 0 0 21 16z"></path>
              </svg>
              Asset Specifications
            </div>
            <span class="badge badge-category"><%= asset.category %></span>
          </div>

          <div class="panel-body">
            <div style="margin-bottom: 1.5rem;">
              <span class="asset-tag" style="font-size: 0.85rem;"><%= asset.assetTag %></span>
              <h2 style="font-size: 1.6rem; font-weight: 700; color: var(--cream); margin-top: 0.25rem;"><%= asset.name %></h2>
              <div class="asset-location" style="font-size: 0.85rem; margin-top: 0.5rem;">
                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                  <path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z"></path>
                  <circle cx="12" cy="10" r="3"></circle>
                </svg>
                Location: <%= asset.location %>
              </div>
            </div>

            <div style="background: rgba(11, 9, 10, 0.7); border: 1px solid var(--border-burgundy); border-radius: 10px; padding: 1.25rem; margin-bottom: 1.5rem;">
              <h4 style="font-size: 0.78rem; text-transform: uppercase; color: var(--champagne); letter-spacing: 0.08em; margin-bottom: 0.75rem;">Inventory Stock Matrix</h4>
              <div style="display: grid; grid-template-columns: repeat(3, 1fr); gap: 1rem; text-align: center;">
                <div>
                  <span style="font-size: 0.72rem; color: var(--muted-text); display: block; text-transform: uppercase;">Total</span>
                  <strong style="font-size: 1.4rem; color: var(--cream);"><%= asset.totalQuantity %></strong>
                </div>
                <div>
                  <span style="font-size: 0.72rem; color: var(--muted-text); display: block; text-transform: uppercase;">Available</span>
                  <strong style="font-size: 1.4rem; color: <%= asset.availableQuantity > 0 ? '#A3E635' : '#F87171' %>;"><%= asset.availableQuantity %></strong>
                </div>
                <div>
                  <span style="font-size: 0.72rem; color: var(--muted-text); display: block; text-transform: uppercase;">Issued</span>
                  <strong style="font-size: 1.4rem; color: var(--champagne);"><%= asset.issuedQuantity %></strong>
                </div>
              </div>
            </div>

            <div style="margin-bottom: 1.5rem;">
              <h4 style="font-size: 0.78rem; text-transform: uppercase; color: var(--champagne); letter-spacing: 0.08em; margin-bottom: 0.5rem;">Condition Status</h4>
              <span class="badge <%= asset.condition === 'Good' ? 'badge-approved' : 'badge-damaged' %>" style="font-size: 0.82rem; padding: 0.35rem 0.85rem;">
                ● Physical Condition: <%= asset.condition %>
              </span>
            </div>

            <div>
              <h4 style="font-size: 0.78rem; text-transform: uppercase; color: var(--champagne); letter-spacing: 0.08em; margin-bottom: 0.5rem;">Equipment Description</h4>
              <p style="color: var(--muted-text); font-size: 0.92rem; line-height: 1.7;">
                <%= asset.description || 'Standard institutional laboratory apparatus calibrated for course curriculum and academic research.' %>
              </p>
            </div>
          </div>
        </div>

        <!-- Right: Requisition Form Card -->
        <div class="glass-panel">
          <div class="panel-header">
            <div class="panel-title">
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"></path>
                <polyline points="14 2 14 8 20 8"></polyline>
              </svg>
              Requisition Form
            </div>
          </div>

          <div class="panel-body">
            <% if (asset.availableQuantity > 0) { %>
              <div style="background: rgba(74, 14, 28, 0.25); border: 1px solid var(--border); border-radius: 8px; padding: 1rem; margin-bottom: 1.5rem;">
                <div style="display: flex; align-items: center; gap: 0.5rem; color: var(--champagne); font-weight: 600; font-size: 0.88rem;">
                  <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <circle cx="12" cy="12" r="10"></circle>
                    <line x1="12" y1="16" x2="12" y2="12"></line>
                    <line x1="12" y1="8" x2="12.01" y2="8"></line>
                  </svg>
                  Available Stock: <%= asset.availableQuantity %> Units
                </div>
                <p style="color: var(--muted-text); font-size: 0.78rem; margin-top: 0.35rem;">
                  You may request up to a maximum of <strong><%= asset.availableQuantity %></strong> unit(s).
                </p>
              </div>

              <!-- Form error notice box -->
              <div id="requestFormError" style="display: none; background: rgba(239, 68, 68, 0.15); border: 1px solid #EF4444; border-radius: 8px; padding: 0.85rem; margin-bottom: 1.25rem; color: #FCA5A5; font-size: 0.85rem;"></div>

              <form id="equipmentRequestForm" action="/requester/request" method="POST">
                <input type="hidden" name="assetId" value="<%= asset._id %>">

                <div class="form-group">
                  <label class="form-label" for="requestQuantity">Quantity Required</label>
                  <input 
                    type="number" 
                    id="requestQuantity" 
                    name="quantity" 
                    class="form-control" 
                    min="1" 
                    max="<%= asset.availableQuantity %>" 
                    value="1" 
                    required
                  >
                  <small style="color: var(--muted-text); font-size: 0.75rem; margin-top: 0.25rem; display: block;">
                    Must not exceed current available stock (<%= asset.availableQuantity %>).
                  </small>
                </div>

                <div class="form-group">
                  <label class="form-label" for="purpose">Purpose of Issue</label>
                  <textarea 
                    id="purpose" 
                    name="purpose" 
                    class="form-control" 
                    placeholder="e.g., EC402 DSP Lab practical experiment, capstone project prototyping..."
                    required
                  ></textarea>
                </div>

                <div class="form-group">
                  <label class="form-label" for="expectedReturnDate">Expected Return Date</label>
                  <input 
                    type="date" 
                    id="expectedReturnDate" 
                    name="expectedReturnDate" 
                    class="form-control" 
                    required
                  >
                  <small style="color: var(--muted-text); font-size: 0.75rem; margin-top: 0.25rem; display: block;">
                    Items returned after this date will automatically be flagged as OVERDUE.
                  </small>
                </div>

                <button type="submit" class="btn btn-primary" style="width: 100%; padding: 0.85rem; font-size: 0.95rem; margin-top: 0.5rem;">
                  Submit Equipment Request
                </button>
              </form>
            <% } else { %>
              <div class="empty-state" style="padding: 2rem 1rem;">
                <svg class="empty-state-icon" style="color: #F87171;" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
                  <circle cx="12" cy="12" r="10"></circle>
                  <line x1="15" y1="9" x2="9" y2="15"></line>
                  <line x1="9" y1="9" x2="15" y2="15"></line>
                </svg>
                <h3 style="color: #F87171;">Currently Out of Stock</h3>
                <p>All <%= asset.totalQuantity %> units of this asset are currently issued to other students or under maintenance.</p>
                <a href="/requester/browse" class="btn btn-secondary btn-sm">Explore Other Assets</a>
              </div>
            <% } %>
          </div>
        </div>
      </div>
    </main>
  </div>
</div>

<%- include('../partials/footer') %>
