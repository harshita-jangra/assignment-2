<%- include('../partials/head') %>

<div class="app-container">
  <%- include('../partials/sidebar') %>

  <div class="main-wrapper">
    <%- include('../partials/header', { 
      pageHeadline: 'Lab Equipment Catalog',
      pageSubheadline: 'Explore available hardware, sensors, test benches, and requisition items.'
    }) %>
    <%- include('../partials/toasts') %>

    <main class="content-body">
      <!-- Search & Category Filters Bar -->
      <div class="glass-panel" style="margin-bottom: 2rem;">
        <div class="panel-body" style="padding: 1.25rem 1.5rem;">
          <form action="/requester/browse" method="GET" style="display: flex; gap: 1rem; flex-wrap: wrap; align-items: center; justify-content: space-between;">
            <div style="flex: 1; min-width: 260px; display: flex; gap: 0.5rem;">
              <input 
                type="text" 
                name="search" 
                class="form-control" 
                placeholder="Search equipment name, asset tag, or room..."
                value="<%= searchQuery %>"
              >
              <button type="submit" class="btn btn-primary btn-sm">Search</button>
              <% if (searchQuery || selectedCategory !== 'All') { %>
                <a href="/requester/browse" class="btn btn-secondary btn-sm" title="Clear Filters">Reset</a>
              <% } %>
            </div>

            <div style="display: flex; gap: 0.5rem; flex-wrap: wrap;">
              <a href="/requester/browse?search=<%= searchQuery %>&category=All" 
                 class="btn btn-sm <%= selectedCategory === 'All' ? 'btn-primary' : 'btn-secondary' %>">
                All Categories
              </a>
              <% categories.forEach(cat => { %>
                <a href="/requester/browse?search=<%= searchQuery %>&category=<%= encodeURIComponent(cat) %>" 
                   class="btn btn-sm <%= selectedCategory === cat ? 'btn-primary' : 'btn-secondary' %>">
                  <%= cat %>
                </a>
              <% }) %>
            </div>
          </form>
        </div>
      </div>

      <!-- Equipment Grid -->
      <% if (assets && assets.length > 0) { %>
        <div class="asset-grid">
          <% assets.forEach(asset => { %>
            <div class="asset-card">
              <div class="asset-card-media">
                <svg class="asset-icon-display" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
                  <% if (asset.category.includes('Electronics') || asset.category.includes('Testing')) { %>
                    <circle cx="12" cy="12" r="9"></circle>
                    <polyline points="12 3 12 12 16 14"></polyline>
                  <% } else if (asset.category.includes('Computing') || asset.category.includes('Prototyping')) { %>
                    <rect x="4" y="4" width="16" height="16" rx="2" ry="2"></rect>
                    <rect x="9" y="9" width="6" height="6"></rect>
                    <line x1="9" y1="1" x2="9" y2="4"></line>
                    <line x1="15" y1="1" x2="15" y2="4"></line>
                    <line x1="9" y1="20" x2="9" y2="23"></line>
                    <line x1="15" y1="20" x2="15" y2="23"></line>
                  <% } else { %>
                    <path d="M14.7 6.3a1 1 0 0 0 0 1.4l1.6 1.6a1 1 0 0 0 1.4 0l3.77-3.77a6 6 0 0 1-7.94 7.94l-6.91 6.91a2.12 2.12 0 0 1-3-3l6.91-6.91a6 6 0 0 1 7.94-7.94l-3.76 3.76z"></path>
                  <% } %>
                </svg>

                <div class="asset-badge-float">
                  <span class="badge badge-category"><%= asset.category %></span>
                </div>
              </div>

              <div class="asset-card-content">
                <div class="asset-tag"><%= asset.assetTag %></div>
                <h3 class="asset-title"><%= asset.name %></h3>
                <div class="asset-location">
                  <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z"></path>
                    <circle cx="12" cy="10" r="3"></circle>
                  </svg>
                  <%= asset.location %>
                </div>

                <div style="font-size: 0.8rem; color: var(--muted-text); margin-bottom: 1rem; line-height: 1.4; display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; overflow: hidden;">
                  <%= asset.description || 'High precision academic lab asset.' %>
                </div>

                <div class="asset-stock-indicator">
                  <div>
                    <span style="font-size: 0.72rem; text-transform: uppercase; color: var(--muted-text); display: block;">Availability</span>
                    <% if (asset.availableQuantity > 0) { %>
                      <span class="stock-count in-stock">● <%= asset.availableQuantity %> Available</span>
                    <% } else { %>
                      <span class="stock-count out-of-stock">✕ Out of Stock</span>
                    <% } %>
                  </div>
                  <div>
                    <span class="badge <%= asset.condition === 'Good' ? 'badge-approved' : 'badge-damaged' %>">
                      <%= asset.condition %>
                    </span>
                  </div>
                </div>

                <div style="margin-top: 1.25rem;">
                  <a href="/requester/assets/<%= asset._id %>" class="btn <%= asset.availableQuantity > 0 ? 'btn-primary' : 'btn-secondary' %>" style="width: 100%;">
                    <%= asset.availableQuantity > 0 ? 'Request Equipment' : 'View Details' %>
                  </a>
                </div>
              </div>
            </div>
          <% }) %>
        </div>
      <% } else { %>
        <div class="glass-panel">
          <div class="empty-state">
            <svg class="empty-state-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
              <circle cx="11" cy="11" r="8"></circle>
              <line x1="21" y1="21" x2="16.65" y2="16.65"></line>
            </svg>
            <h3>No Equipment Found</h3>
            <p>No laboratory assets matched your search or category filter criteria.</p>
            <a href="/requester/browse" class="btn btn-secondary btn-sm">Clear All Filters</a>
          </div>
        </div>
      <% } %>
    </main>
  </div>
</div>

<%- include('../partials/footer') %>
