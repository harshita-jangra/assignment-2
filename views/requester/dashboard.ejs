<%- include('../partials/head') %>

<div class="app-container">
  <%- include('../partials/sidebar') %>

  <div class="main-wrapper">
    <%- include('../partials/header', { 
      pageHeadline: `Good day, ${user.name.split(' ')[0]}`,
      pageSubheadline: 'Track your requisitioned equipment and active laboratory loans.'
    }) %>
    <%- include('../partials/toasts') %>

    <main class="content-body">
      <!-- Welcome Hero Banner -->
      <div style="background: linear-gradient(135deg, rgba(74, 14, 28, 0.45) 0%, rgba(17, 16, 17, 0.8) 100%); border: 1px solid var(--border-burgundy); border-radius: 14px; padding: 1.75rem 2rem; margin-bottom: 2rem; display: flex; align-items: center; justify-content: space-between; flex-wrap: gap: 1.5rem; box-shadow: var(--shadow-elevated);">
        <div>
          <span style="font-size: 0.72rem; text-transform: uppercase; letter-spacing: 0.12em; color: var(--champagne); font-weight: 700;">Institutional Asset Management</span>
          <h2 style="font-size: 1.6rem; font-weight: 700; margin-top: 0.35rem; color: var(--cream);">Equipment Loan Central</h2>
          <p style="color: var(--muted-text); font-size: 0.88rem; max-width: 520px; margin-top: 0.25rem;">
            Browse the laboratory catalog to reserve multimeters, oscilloscopes, development boards, and specialized hardware for your academic research.
          </p>
        </div>
        <div>
          <a href="/requester/browse" class="btn btn-primary" style="padding: 0.85rem 1.5rem; font-size: 0.95rem;">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <circle cx="11" cy="11" r="8"></circle>
              <line x1="21" y1="21" x2="16.65" y2="16.65"></line>
            </svg>
            Browse Equipment Catalog
          </a>
        </div>
      </div>

      <!-- Key Metrics -->
      <div class="stats-grid">
        <div class="stat-card">
          <div class="stat-header">
            <span class="stat-label">Total Requests</span>
            <div class="stat-icon">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"></path>
                <polyline points="14 2 14 8 20 8"></polyline>
              </svg>
            </div>
          </div>
          <div class="stat-value"><%= stats.totalRequests %></div>
          <div class="stat-subtext">Lifetime loan requisitions</div>
        </div>

        <div class="stat-card">
          <div class="stat-header">
            <span class="stat-label">Pending Approval</span>
            <div class="stat-icon" style="background: rgba(100, 21, 42, 0.4);">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <circle cx="12" cy="12" r="10"></circle>
                <polyline points="12 6 12 12 16 14"></polyline>
              </svg>
            </div>
          </div>
          <div class="stat-value"><%= stats.pendingCount %></div>
          <div class="stat-subtext">Awaiting Lab In-charge review</div>
        </div>

        <div class="stat-card">
          <div class="stat-header">
            <span class="stat-label">Currently Issued</span>
            <div class="stat-icon" style="background: rgba(74, 14, 28, 0.6);">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <rect x="2" y="7" width="20" height="14" rx="2" ry="2"></rect>
                <path d="M16 21V5a2 2 0 0 0-2-2h-4a2 2 0 0 0-2 2v16"></path>
              </svg>
            </div>
          </div>
          <div class="stat-value"><%= stats.issuedCount %></div>
          <div class="stat-subtext">Items in your possession</div>
        </div>

        <div class="stat-card" style="<%= stats.overdueCount > 0 ? 'border-color: #EF4444;' : '' %>">
          <div class="stat-header">
            <span class="stat-label" style="<%= stats.overdueCount > 0 ? 'color: #EF4444;' : '' %>">Overdue Returns</span>
            <div class="stat-icon" style="background: rgba(180, 20, 30, 0.3);">
              <svg viewBox="0 0 24 24" fill="none" stroke="<%= stats.overdueCount > 0 ? '#EF4444' : 'currentColor' %>" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <polygon points="7.86 2 16.14 2 22 7.86 22 16.14 16.14 22 7.86 22 2 16.14 2 7.86 7.86 2"></polygon>
                <line x1="12" y1="8" x2="12" y2="12"></line>
                <line x1="12" y1="16" x2="12.01" y2="16"></line>
              </svg>
            </div>
          </div>
          <div class="stat-value" style="<%= stats.overdueCount > 0 ? 'color: #EF4444;' : '' %>"><%= stats.overdueCount %></div>
          <div class="stat-subtext">Immediate return required</div>
        </div>
      </div>

      <!-- Active Loans Panel -->
      <div class="glass-panel">
        <div class="panel-header">
          <div class="panel-title">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <rect x="2" y="7" width="20" height="14" rx="2" ry="2"></rect>
              <path d="M16 21V5a2 2 0 0 0-2-2h-4a2 2 0 0 0-2 2v16"></path>
            </svg>
            Currently Issued Equipment in Your Custody
          </div>
          <a href="/requester/my-requests" class="btn btn-secondary btn-sm">View All History</a>
        </div>

        <div class="table-responsive">
          <% if (activeIssues && activeIssues.length > 0) { %>
            <table class="custom-table">
              <thead>
                <tr>
                  <th>Asset Tag</th>
                  <th>Equipment</th>
                  <th>Quantity</th>
                  <th>Issued Date</th>
                  <th>Expected Return</th>
                  <th>Status</th>
                </tr>
              </thead>
              <tbody>
                <% activeIssues.forEach(reqItem => { %>
                  <% const isOverdue = new Date(reqItem.expectedReturnDate) < new Date(); %>
                  <tr>
                    <td><span class="asset-tag"><%= reqItem.asset ? reqItem.asset.assetTag : 'N/A' %></span></td>
                    <td style="font-weight: 600;"><%= reqItem.asset ? reqItem.asset.name : 'Unknown Asset' %></td>
                    <td><span class="badge badge-category"><%= reqItem.quantity %> Units</span></td>
                    <td><%= reqItem.issuedAt ? new Date(reqItem.issuedAt).toLocaleDateString() : 'N/A' %></td>
                    <td>
                      <span style="<%= isOverdue ? 'color: #EF4444; font-weight: 700;' : '' %>">
                        <%= new Date(reqItem.expectedReturnDate).toLocaleDateString() %>
                      </span>
                    </td>
                    <td>
                      <% if (isOverdue) { %>
                        <span class="badge badge-overdue">⚠ OVERDUE</span>
                      <% } else { %>
                        <span class="badge badge-issued">ACTIVE LOAN</span>
                      <% } %>
                    </td>
                  </tr>
                <% }) %>
              </tbody>
            </table>
          <% } else { %>
            <div class="empty-state">
              <svg class="empty-state-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
                <rect x="2" y="7" width="20" height="14" rx="2" ry="2"></rect>
                <path d="M16 21V5a2 2 0 0 0-2-2h-4a2 2 0 0 0-2 2v16"></path>
              </svg>
              <h3>No Active Equipment Loans</h3>
              <p>You currently do not have any issued laboratory equipment under your custody.</p>
              <a href="/requester/browse" class="btn btn-primary btn-sm">Request Equipment</a>
            </div>
          <% } %>
        </div>
      </div>

      <!-- Recent Requisitions -->
      <div class="glass-panel">
        <div class="panel-header">
          <div class="panel-title">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"></path>
              <polyline points="14 2 14 8 20 8"></polyline>
            </svg>
            Recent Requisitions
          </div>
        </div>

        <div class="table-responsive">
          <% if (recentRequests && recentRequests.length > 0) { %>
            <table class="custom-table">
              <thead>
                <tr>
                  <th>Date</th>
                  <th>Equipment</th>
                  <th>Purpose</th>
                  <th>Qty</th>
                  <th>Status</th>
                </tr>
              </thead>
              <tbody>
                <% recentRequests.forEach(r => { %>
                  <tr>
                    <td><%= new Date(r.requestDate).toLocaleDateString() %></td>
                    <td style="font-weight: 600;"><%= r.asset ? r.asset.name : 'Unknown' %></td>
                    <td style="color: var(--muted-text);"><%= r.purpose %></td>
                    <td><%= r.quantity %></td>
                    <td>
                      <% if (r.status === 'Pending') { %>
                        <span class="badge badge-pending">Pending</span>
                      <% } else if (r.status === 'Approved') { %>
                        <span class="badge badge-approved">Approved</span>
                      <% } else if (r.status === 'Issued') { %>
                        <span class="badge badge-issued">Issued</span>
                      <% } else if (r.status === 'Returned') { %>
                        <span class="badge badge-returned">Returned</span>
                      <% } else if (r.status === 'Rejected') { %>
                        <span class="badge badge-lost">Rejected</span>
                      <% } %>
                    </td>
                  </tr>
                <% }) %>
              </tbody>
            </table>
          <% } else { %>
            <div class="empty-state">
              <h3>No Requisitions Found</h3>
              <p>You haven't submitted any equipment issue requests yet.</p>
            </div>
          <% } %>
        </div>
      </div>
    </main>
  </div>
</div>

<%- include('../partials/footer') %>
